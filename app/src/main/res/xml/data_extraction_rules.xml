<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Legacy release-gate markers only. Databases and datastore are intentionally not included:
         domain="database" path="." and path="datastore/" -->
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="encrypted_ai_credentials_v1.xml" />
        <exclude domain="sharedpref" path="encrypted_source_sessions_v1.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="encrypted_ai_credentials_v1.xml" />
        <exclude domain="sharedpref" path="encrypted_source_sessions_v1.xml" />
    </device-transfer>
</data-extraction-rules>
