<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="encrypted_ai_credentials_v1.xml" />
        <exclude domain="sharedpref" path="encrypted_source_sessions_v1.xml" />
        <exclude domain="file" path="datastore/" />
        <exclude domain="cache" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="encrypted_ai_credentials_v1.xml" />
        <exclude domain="sharedpref" path="encrypted_source_sessions_v1.xml" />
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
