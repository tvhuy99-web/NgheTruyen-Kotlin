+    private fun diagnostic(
+        name: String,
+        traceId: String,
+        severity: DiagnosticSeverity = DiagnosticSeverity.INFO,
+        attributes: Map<String, String> = emptyMap(),
+    ) {
+        AudioPipelineJournal.record(
+            context = appContext,
+            name = name,
+            sourceId = "freesound-importer",
+            traceId = traceId,
+            severity = severity.name,
+            attributes = attributes,
+        )
+        val application = appContext as? NgheTruyenApplication ?: return
+        runCatching {
+            application.container.sourceDiagnostics.mark(
+                name = name,
+                category = DiagnosticCategory.RUNTIME,
+                severity = severity,
+                sourceId = "freesound",
+                traceId = traceId,
+                attributes = attributes,
+            )
+        }
+    }
