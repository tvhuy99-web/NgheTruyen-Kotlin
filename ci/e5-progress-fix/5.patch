+    private fun diagnostic(
+        name: String,
+        traceId: String,
+        severity: DiagnosticSeverity = DiagnosticSeverity.INFO,
+        attributes: Map<String, String> = emptyMap(),
+    ) {
+        val application = applicationContext as? NgheTruyenApplication ?: return
+        val mergedAttributes = mapOf(
+            "modelId" to MODEL_ID,
+            "packVersion" to PACK_VERSION.toString(),
+            "backend" to backendName(),
+        ) + attributes
+        AudioPipelineJournal.record(
+            context = application,
+            name = name,
+            sourceId = "mode3-e5",
+            traceId = traceId,
+            severity = severity.name,
+            attributes = mergedAttributes,
+        )
+        runCatching {
+            application.container.sourceDiagnostics.mark(
+                name = name,
+                category = DiagnosticCategory.RUNTIME,
+                severity = severity,
+                sourceId = "mode3-e5",
+                traceId = traceId,
+                attributes = mergedAttributes,
+            )
+        }
+    }
