{
  "version": 1,
  "steps": [
    {"op":"resourceJson","path":"data/catalog.json","as":"catalog"},
    {"op":"path","from":"catalog","path":"stories","as":"stories"},
    {"op":"filterText","from":"stories","fields":["title","author"],"queryInput":"query","as":"filtered"},
    {"op":"paginate","from":"filtered","pageInput":"page","pageSize":20,"as":"result"},
    {"op":"emit","from":"result"}
  ]
}
