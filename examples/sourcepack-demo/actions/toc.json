{
  "version": 1,
  "steps": [
    {"op":"resourceJson","path":"data/catalog.json","as":"catalog"},
    {"op":"path","from":"catalog","path":"stories","as":"stories"},
    {"op":"find","from":"stories","fields":["url","id"],"input":"url","as":"story"},
    {"op":"path","from":"story","path":"chapters","as":"result"},
    {"op":"emit","from":"result"}
  ]
}
